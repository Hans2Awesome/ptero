# FastAPI Backend — AppFinanceIndv (vendored ke ptero/vendor/finapi)
# SECRET_KEY dibiarkan kosong: postinstall.js membuat nilai acak saat .env dibuat.
SECRET_KEY=
ENVIRONMENT=development
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Relatif terhadap cwd proses. PM2 menjalankan finapi dengan cwd=vendor/finapi,
# jadi file ini menunjuk vendor/finapi/bot04.sqlite3.
DATABASE_PATH=bot04.sqlite3

TIMEZONE=Asia/Jakarta
CURRENCY=IDR

# Comma separated origins. Jangan pakai * bersama credentials.
CORS_ORIGINS=http://localhost:8081