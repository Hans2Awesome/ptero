############################
# 0) MODE & TOOLING
############################
LOG_TARGET=finapi
NEXT_TELEMETRY_DISABLED=1
TZ=Asia/Jakarta
GENERIC_TIMEZONE=Asia/Jakarta

############################
# 1) IDENTITAS & HOSTNAME
############################
TENANT_SLUG=harun
N8N_HOST=n8n.example.com
GOWA_HOST=gowa.example.com
VARS_HOST=vars.example.com
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=https://n8n.example.com
N8N_PROXY_HOPS=1
# WEBHOOK_URL dikosongkan: start.sh mengisinya dari N8N_EDITOR_BASE_URL
WEBHOOK_URL=

#################################
# 2) PORT INTERNAL
#################################
N8N_PORT=11100
N8N_WEBHOOK_PORT=11101
GOWA_PORT=11500
VARS_PORT=11300
VARUI_PORT=11300
APP_PORT=11500

# WEBSITE-1 (hanya dipakai jika folder web/1 ada)
WEB1_PORT=11410
WEB1_HOST=0.0.0.0
WEB1_BASE_URL=https://my.example.com

#########################
# 3) N8N
#########################
# Login n8n memakai user management bawaan (N8N_BASIC_AUTH_* sudah dihapus sejak n8n 1.0).
# Buat akun owner saat pertama kali membuka editor.
# n8n hanya dipasang jika ENABLE_N8N=1 (postinstall.js memilih versi sesuai Node).
# Node v22/v23 -> n8n 2.35.7, Node v24+ -> n8n 2.45.6.
# N8N_ENCRYPTION_KEY: dibiarkan kosong, postinstall.js membuat nilai acak saat .env dibuat.
# Mengganti nilai ini membuat credential lama tidak terbaca.
N8N_ENCRYPTION_KEY=
N8N_LOG_LEVEL=info
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# n8n 2.x: akses $env dari Code node diblokir secara default. Set false jika workflow butuh $env.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# n8n 2.x: mode binary data "default" (in-memory) dihapus.
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

#########################
# 4) GOWA
#########################
# Dibiarkan kosong: postinstall.js membuat user:password acak saat .env dibuat.
APP_BASIC_AUTH=
DB_URI=file:gowa/whatsapp.db?_foreign_keys=on
APP_DEBUG=false

#########################
# 5) VARS UI (login panel .env)
#########################
# WAJIB diisi. Panel ini bisa menulis .env dan me-restart semua proses,
# jadi kredensial lemah = eksekusi kode. Kosong = dibuat acak oleh postinstall.js.
VARUI_USER=admin
VARUI_PASS=

############################
# 6) TELEGRAM BOTS (nonaktif: folder tb/ tidak ada di bundel ini)
############################
TB1_TELEGRAM_BOT_NAME="Bot"
TB1_TELEGRAM_OWNER_NAME=Owner
TB1_TELEGRAM_BOT_THUMBNAIL=
TB1_TELEGRAM_BOT_TOKEN=
TB1_TELEGRAM_OWNER_ID=
TB2_TELEGRAM_BOT_TOKEN=
TB2_TELEGRAM_OWNER_ID=

############################
# 7) CLOUDFLARE
############################
# Tunnel tidak akan jalan selama token kosong.
CLOUDFLARE_TOKEN=
CLOUDFLARED_LOGLEVEL=warn

############################
# 8) TOGGLE PER-APP (1=ON, 0=OFF)
############################
ENABLE_N8N=0
ENABLE_N8N_WEBHOOK=0
ENABLE_GOWA=0
ENABLE_VARS=1
ENABLE_WEBSITE1=0
ENABLE_TUNNEL=1
# FinAPI (FastAPI backend AppFinanceIndv) — butuh venv yang dibuat `npm install`
# FINAPI_PORT harus sama dengan service di Cloudflare Tunnel.
# Contoh: api.finindv.nikahbos.web.id -> http://localhost:11011
ENABLE_FINAPI=1
FINAPI_PORT=11011
FINAPI_HOST=127.0.0.1
FINAPI_MAX_MEMORY=250M

# Override: jalankan HANYA daftar ini (comma-separated). Kosong = pakai toggle di atas.
# Nama valid: n8n, gowa, vars-ui, redis, website-1, cf-tunnel, finapi
RUN_APPS=

############################
# 9) QUEUE MODE + REDIS
############################
# OFF = satu proses n8n (paling hemat RAM, paling sedikit titik gagal).
# ON  = n8n-main + n8n-worker, butuh Redis + Postgres.
N8N_QUEUE_MODE=off

# Kosong = ikut N8N_QUEUE_MODE. Isi 1 untuk paksa ON.
ENABLE_REDIS=0

REDIS_PORT=6379
REDIS_BIND=127.0.0.1
# Dibiarkan kosong: postinstall.js membuat password acak saat .env dibuat.
REDIS_PASSWORD=
REDIS_MAXMEMORY_MB=512
REDIS_APPENDONLY=yes
REDIS_SAVE=900 1 300 10 60 10000
REDIS_DATA_DIR=redis/data
REDIS_LOGFILE=

REDIS_BINARY_URL_AMD64=https://download.valkey.io/releases/valkey-8.1.3-jammy-x86_64.tar.gz
REDIS_BINARY_URL_ARM64=https://download.valkey.io/releases/valkey-8.1.3-jammy-arm64.tar.gz

LOG_ROOT=logs

# Hanya dipakai kalau N8N_QUEUE_MODE=on. Password mengikuti REDIS_PASSWORD.
QUEUE_BULL_REDIS_HOST=127.0.0.1
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=
QUEUE_BULL_REDIS_DB=0
QUEUE_BULL_PREFIX=n8n
N8N_WORKERS=1
N8N_WORKER_CONCURRENCY=4
N8N_MAIN_MAX_MEMORY=1200M
N8N_WORKER_MAX_MEMORY=900M

############################
# 10) DATABASE
############################
# Queue mode mewajibkan Postgres. Koneksi ini TIDAK memakai TLS: sebaiknya
# pakai Postgres lokal/private network, bukan IP publik.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_POOL_SIZE=10
DB_POSTGRESDB_CONNECTION_TIMEOUT=20000
DB_POSTGRESDB_IDLE_CONNECTION_TIMEOUT=30000

############################
# 11) PRUNING EKSEKUSI
############################
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all